{
	"schemaVersion": 1,
	"id": "betterflying",
	"version": "${version}",
	"name": "Better Flying",
	"description": "Creative and spectator flight improvements: a toggle keybind, optional double-tap-jump to fly, flight inertia, and per-axis speed multipliers.",
	"authors": [
		"chylex (original Better Controls)",
		"wlm3201 (porter)"
	],
	"contact": {
		"sources": "https://github.com/wlm3201/better-flying"
	},
	"license": "MPL-2.0",
	"icon": "assets/betterflying/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.betterflying.client.BetterFlying"],
		"modmenu": ["com.betterflying.client.compat.modmenu.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "betterflying.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"java": ">=25",
		"minecraft": "${minecraft_dependency}"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}
