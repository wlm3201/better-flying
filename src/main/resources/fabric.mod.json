{
	"schemaVersion": 1,
	"id": "betterflying",
	"version": "${version}",
	"name": "Better Flying",
	"description": "Improvements for creative flight: toggle flight keybind, optional double tap jump to fly, flight inertia and speed multipliers, disabling field of view changes while flying, and flying on ground.\nPorted from Better Controls by chylex.",
	"authors": [
		"chylex (original Better Controls)",
		"ported to Minecraft 26.1.2"
	],
	"license": "MPL-2.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.betterflying.BetterFlying"
		],
		"modmenu": [
			"com.betterflying.compat.modmenu.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "betterflying.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"java": ">=25",
		"minecraft": "~26.1"
	},
	"recommends": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}
